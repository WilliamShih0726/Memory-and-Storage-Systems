[global]
filename=testfile
bs=4k
size=64m
ioengine=psync
stonewall

[buffered_seqread]
rw=read
direct=0
name=buffered_seqread

[nonbuffered_seqread]
rw=read
direct=1
name=nonbuffered_seqread

[buffered_randread]
rw=randread
direct=0
name=buffered_randread

[nonbuffered_randread]
rw=randread
direct=1
name=nonbuffered_randread
